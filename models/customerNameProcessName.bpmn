    <serviceTask id="transferToFitConnect" name="Daten an FIT-Connect senden" activiti:class="de.seitenbau.serviceportal.prozess.servicetask.FitConnectSubmissionService">
      <extensionElements>
        <activiti:field name="clientId">
          <activiti:expression>
            <![CDATA[${fitConnectClientId}]]>
          </activiti:expression>
        </activiti:field>
        <activiti:field name="clientSecret">
          <activiti:expression>
            <![CDATA[${fitConnectClientSecret}]]>
          </activiti:expression>
        </activiti:field>
        <activiti:field name="destinationId">
          <activiti:expression>
            <![CDATA[${fitConnectDestinationId}]]>
          </activiti:expression>
        </activiti:field>
        <activiti:field name="serviceName">
          <activiti:string>
            <![CDATA[TODO: Muss vom Fachverfahrenshersteller erfragt werden]]>
          </activiti:string>
        </activiti:field>
        <activiti:field name="serviceIdentifier">
          <activiti:string>
            <![CDATA[TODO: Muss vom Fachverfahrenshersteller erfragt werden, z. B. urn:de:fim:leika:leistung:99001003004000]]>
          </activiti:string>
        </activiti:field>
        <activiti:field name="mimeType">
          <activiti:string>
            <![CDATA[TODO: Muss vom Fachverfahrenshersteller erfragt werden, z. B. application/json]]>
          </activiti:string>
        </activiti:field>
        <activiti:field name="schemaURI">
          <activiti:string>
            <![CDATA[TODO: Muss vom Fachverfahrenshersteller erfragt werden, z. B. https://schema.fitko.de/fim/s00000000009_1.0.0.schema.json]]>
          </activiti:string>
        </activiti:field>
        <activiti:field name="fachdaten">
          <activiti:expression>
            <![CDATA[${fitConnectPayload}]]>
          </activiti:expression>
        </activiti:field>
        <activiti:field name="attachments">
          <activiti:expression>
            <![CDATA[${fitConnectAttachments}]]>
          </activiti:expression>
        </activiti:field>
        <activiti:field name="target">
          <activiti:string>
            <![CDATA[fitConnectResult]]>
          </activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow22" sourceRef="prepareFitConntectTransfer" targetRef="transferToFitConnect"></sequenceFlow>
