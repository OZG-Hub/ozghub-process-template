          </activiti:expression>
        </activiti:field>
        <activiti:field name="betreff">
          <activiti:string>
            <![CDATA[TODO_HIER_PROZESSNAME: Antrag eingegangen]]>
          </activiti:string>
        </activiti:field>
        <activiti:field name="text">
          <activiti:expression>
            <![CDATA[Guten Tag,

Ihr Antrag auf ein TODO_HIER_PROZESSNAME wurde erfolgreich an die zuständige Stelle übertragen. 

Im Anhang finden Sie eine Kopie Ihrer gemachten Angaben als PDF-Datei.

Bei der Übertragung wurden folgende IDs gesetzt:
Einreichungs-ID: ${fitConnectSubmissionId}
Vorgangs-ID der Einreichung: ${fitConnectCaseId}]]>
          </activiti:expression>
        </activiti:field>
        <activiti:field name="anhaenge">
          <activiti:expression>
            <![CDATA[${applicantFormAsPdf}]]>
          </activiti:expression>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow28" sourceRef="sendMessageToApplicant" targetRef="finalPage"></sequenceFlow>
    <userTask id="finalPage" name="Antrag auf TODO_PROZESSNAME_HIER eingegangen" activiti:formKey="showOnce" activiti:assignee="${startParameter.startedByUser.userId}">
