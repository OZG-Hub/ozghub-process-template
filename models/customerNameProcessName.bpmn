      <conditionExpression xsi:type="tFormalExpression">
        <![CDATA[${clickedButton == "continue"}]]>
      </conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="exclusivegateway3" name="Exclusive Gateway"></exclusiveGateway>
